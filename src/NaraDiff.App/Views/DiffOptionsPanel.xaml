<UserControl x:Class="NaraDiff.App.Views.DiffOptionsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:NaraDiff.App.Controls"
             FontFamily="Segoe UI" FontSize="12" UseLayoutRounding="True" SnapsToDevicePixels="True"
             Width="308" Background="{DynamicResource Surface}">
  <Border BorderBrush="{DynamicResource Border}" BorderThickness="1,0,0,0">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Border Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="12,8">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock Text="Comparison options" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <controls:IconButton Grid.Column="1" Icon="{DynamicResource IconClose}" ToolTip="Hide the options panel" Click="Close_Click"/>
        </Grid>
      </Border>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="12,10">
        <StackPanel>
          <TextBlock Text="Preset" Style="{DynamicResource SectionLabel}"/>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <ComboBox x:Name="PresetBox" SelectionChanged="Preset_Changed" ToolTip="Load a saved set of options"/>
            <controls:IconButton Grid.Column="1" Icon="{DynamicResource IconClose}" ToolTip="Delete the selected preset" Click="DeletePreset_Click"/>
          </Grid>
          <Grid Margin="0,6,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox x:Name="PresetNameBox" ToolTip="Name for a new preset"/>
            <Button Grid.Column="1" Content="Save" MinWidth="58" Margin="6,0,0,0" Click="SavePreset_Click"/>
          </Grid>
        
          <Separator/>
          <TextBlock Text="Algorithm" Style="{DynamicResource SectionLabel}"/>
          <ComboBox x:Name="AlgorithmBox" SelectionChanged="Option_Changed"
                    ToolTip="Myers is minimal, patience and histogram produce more readable hunks"/>
          <TextBlock Text="Inline highlighting" Style="{DynamicResource SectionLabel}" Margin="0,10,0,6"/>
          <ComboBox x:Name="InlineBox" SelectionChanged="Option_Changed" ToolTip="Word or character level highlighting inside changed lines"/>
          <CheckBox x:Name="MovesBox" Content="Detect moved blocks" Margin="0,10,0,0" Click="Option_Changed"/>
        
          <Separator/>
          <TextBlock Text="Whitespace" Style="{DynamicResource SectionLabel}"/>
          <CheckBox x:Name="LeadingBox" Content="Ignore leading whitespace" Click="Option_Changed"/>
          <CheckBox x:Name="TrailingBox" Content="Ignore trailing whitespace" Margin="0,6,0,0" Click="Option_Changed"/>
          <CheckBox x:Name="RunsBox" Content="Ignore the number of spaces" Margin="0,6,0,0" Click="Option_Changed"/>
          <CheckBox x:Name="AllWhitespaceBox" Content="Ignore all whitespace" Margin="0,6,0,0" Click="Option_Changed"/>
          <CheckBox x:Name="TabsBox" Content="Treat tabs like spaces" Margin="0,6,0,0" Click="Option_Changed"/>
          <Grid Margin="0,6,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="72"/></Grid.ColumnDefinitions>
            <TextBlock Text="Tab width" VerticalAlignment="Center"/>
            <ComboBox x:Name="TabWidthBox" Grid.Column="1" SelectionChanged="Option_Changed"/>
          </Grid>

          <Separator/>
          <TextBlock Text="Text" Style="{DynamicResource SectionLabel}"/>
          <CheckBox x:Name="CaseBox" Content="Ignore letter case" Click="Option_Changed"/>
          <CheckBox x:Name="BlankLinesBox" Content="Ignore blank line differences" Margin="0,6,0,0" Click="Option_Changed"/>
          <CheckBox x:Name="LineEndingsBox" Content="Ignore line ending differences" Margin="0,6,0,0" Click="Option_Changed"/>

          <Separator/>
          <TextBlock Text="Ignored lines" Style="{DynamicResource SectionLabel}"/>
          <TextBlock Text="Regular expressions, one per line" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
          <TextBox x:Name="PatternBox" Height="70" AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto"
                   VerticalContentAlignment="Top" LostKeyboardFocus="Rules_Committed" ToolTip="A line matching any pattern is excluded from the comparison"/>
          <TextBlock x:Name="PatternError" Foreground="#FFF85149" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed"/>
          <TextBlock Text="Ignored prefixes, separated by spaces" Foreground="{DynamicResource TextSecondary}" Margin="0,8,0,4"/>
          <TextBox x:Name="PrefixBox" LostKeyboardFocus="Rules_Committed" ToolTip="For example: // # -- ;"/>

          <Separator/>
          <Button Content="Reset to defaults" Margin="0,4,0,12" Click="Reset_Click"/>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Border>
</UserControl>
