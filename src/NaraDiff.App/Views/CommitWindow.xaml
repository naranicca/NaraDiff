<Window x:Class="NaraDiff.App.Views.CommitWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Commit" Width="760" Height="600" MinWidth="480" MinHeight="400" WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" FontSize="12" UseLayoutRounding="True" SnapsToDevicePixels="True"
        Background="{DynamicResource Surface}" Foreground="{DynamicResource TextPrimary}">
  <Grid Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock x:Name="BranchText" Grid.Row="0" FontWeight="SemiBold" Margin="0,0,0,10"/>

    <Border Grid.Row="1" Style="{DynamicResource Card}">
      <StackPanel>
        <TextBlock Text="Commit message" Style="{DynamicResource SectionLabel}"/>
        <TextBox x:Name="MessageInput" Height="110" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"
                 VerticalScrollBarVisibility="Auto" Padding="7,5" TextChanged="Message_Changed"
                 ToolTip="The first line is the summary; leave a blank line before any further description"/>
      </StackPanel>
    </Border>

    <Grid Grid.Row="2" Margin="2,12,2,6">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <CheckBox x:Name="AllBox" Content="Files to commit" FontWeight="SemiBold" IsThreeState="False" Click="All_Click"/>
      <TextBlock x:Name="CountText" Grid.Column="1" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
    </Grid>

    <Border Grid.Row="3" Style="{DynamicResource Card}" Padding="0">
      <ListBox x:Name="FileList" Background="Transparent" BorderThickness="0"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
        <ListBox.ItemContainerStyle>
          <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                  <Border x:Name="Surface" Background="Transparent" Padding="{TemplateBinding Padding}">
                    <ContentPresenter/>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource SurfaceHover}"/></Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Click="Item_Click" Margin="0,0,4,0"/>
              <TextBlock Grid.Column="1" Text="{Binding Status}" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="2" Text="{Binding Path}" ToolTip="{Binding Path}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>

    <Grid Grid.Row="4" Margin="0,14,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <CheckBox x:Name="PushBox" Content="Push after committing" VerticalAlignment="Center"
                ToolTip="Push the current branch to its remote once the commit is made"/>
      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <Button x:Name="CommitButton" Content="Commit" Style="{DynamicResource PrimaryButton}" IsEnabled="False" Click="Commit_Click"/>
        <Button Content="Cancel" Margin="8,0,0,0" IsCancel="True"/>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
