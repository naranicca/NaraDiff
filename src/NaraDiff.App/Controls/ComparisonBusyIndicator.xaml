<UserControl x:Class="NaraDiff.App.Controls.ComparisonBusyIndicator"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Indicator" IsHitTestVisible="False" Focusable="False"
             AutomationProperties.Name="{Binding Message, ElementName=Indicator}"
             AutomationProperties.LiveSetting="Polite">
  <Border Style="{DynamicResource Card}" Padding="20,14" Margin="12"
          HorizontalAlignment="Center" VerticalAlignment="Center">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Grid Width="28" Height="28" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform><RotateTransform/></Grid.RenderTransform>
        <Grid.Style>
          <Style TargetType="Grid">
            <Style.Triggers>
              <Trigger Property="IsVisible" Value="True">
                <Trigger.EnterActions>
                  <BeginStoryboard x:Name="Spin">
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                       From="0" To="360" Duration="0:0:0.9" RepeatBehavior="Forever"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions><RemoveStoryboard BeginStoryboardName="Spin"/></Trigger.ExitActions>
              </Trigger>
            </Style.Triggers>
          </Style>
        </Grid.Style>
        <Ellipse Stroke="{DynamicResource BorderStrong}" StrokeThickness="3" Margin="1"/>
        <Path Data="M 14,2.5 A 11.5,11.5 0 0 1 25.5,14"
              Stroke="{DynamicResource Accent}" StrokeThickness="3"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
      </Grid>
      <TextBlock Grid.Column="1" Text="{Binding Message, ElementName=Indicator}"
                 FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"
                 Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
    </Grid>
  </Border>
</UserControl>
