<UserControl x:Class="NaraDiff.App.Controls.FilePaneSettings"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI" FontSize="12">
  <StackPanel Orientation="Horizontal">
    <ComboBox x:Name="EncodingBox" Width="150" ToolTip="Text encoding used to read and write this file" SelectionChanged="EncodingBox_SelectionChanged"/>
    <ComboBox x:Name="LineEndingBox" Width="104" Margin="6,0,0,0" ToolTip="Line ending written when saving" SelectionChanged="LineEndingBox_SelectionChanged"/>
    <Border x:Name="ReadOnlyChip" Style="{DynamicResource Chip}" Margin="6,0,0,0" Visibility="Collapsed"><TextBlock Text="read-only" Foreground="{DynamicResource TextSecondary}"/></Border>
    <Border x:Name="ModifiedChip" Style="{DynamicResource Chip}" Margin="6,0,0,0" Visibility="Collapsed"><TextBlock Text="modified" Foreground="{DynamicResource Accent}" FontWeight="SemiBold"/></Border>
    <TextBlock x:Name="DetailText" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}"/>
  </StackPanel>
</UserControl>
